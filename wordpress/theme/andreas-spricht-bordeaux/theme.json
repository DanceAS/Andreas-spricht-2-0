{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1360px"
    },
    "color": {
      "palette": [
        {
          "slug": "paper",
          "color": "#faf5ee",
          "name": "Creme"
        },
        {
          "slug": "bordeaux",
          "color": "#591f30",
          "name": "Bordeaux"
        },
        {
          "slug": "rose",
          "color": "#985d70",
          "name": "Rosé"
        }
      ]
    },
    "typography": {
